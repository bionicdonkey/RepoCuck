# Copy to .env (never commit it).
DB_PASSWORD=change-me-to-a-long-random-string
REPOCUCK_BASE_URL=https://apt.example.com
# cloudflared variant only (Zero Trust -> Networks -> Tunnels -> your tunnel -> token):
CLOUDFLARE_TUNNEL_TOKEN=
# Optional: raises the GitHub API limit from 60 to 5000 requests/hour. A token with no scopes is enough (public repositories only).
GITHUB_TOKEN=
# Image to run. Pin an exact version in production; the repository is private, so `docker login ghcr.io` first
# (a token with read:packages). Verify signatures with cosign (see the release notes).
# REPOCUCK_IMAGE=ghcr.io/bionicdonkey/repocuck:1.0.0
