@page
@inject UserService Users
@inject SetupTokenService Setup
@inject IOptions<AuthOptions> Auth
@functions {
    [BindProperty] public string Token { get; set; } = "";
    [BindProperty] public string Username { get; set; } = "";
    [BindProperty] public string Password { get; set; } = "";
    public string? Error { get; set; }

    public async Task<IActionResult> OnGetAsync(CancellationToken ct)
    {
        if (!Setup.IsActive || await Users.AnyUsersAsync(ct)) return NotFound();
        return Page();
    }

    public async Task<IActionResult> OnPostAsync(CancellationToken ct)
    {
        if (await Users.AnyUsersAsync(ct)) return NotFound();
        if (!Setup.Consume(Token)) { Error = "Invalid or expired setup token."; return Page(); }
        try
        {
            var u = await Users.CreateAsync(Username, Username, null, Password, Roles.Admin, false, null, ct);
            await AuthSetup.SignInAsync(HttpContext, u, Auth.Value);
            return LocalRedirect("/repos");
        }
        catch (ServiceException e) { Error = e.Message; Setup.Issue(); return Page(); }
    }
}
@{ Layout = "_AuthLayout"; ViewData["Title"] = "Set up RepoCuck"; }
<div class="stack">
  <h1>Create the first administrator</h1>
  <p class="muted">Paste the one-time setup token the server printed to its console when it started. It expires 30 minutes after startup and works once.</p>
  @if (Error is not null) { <div class="notice error" role="alert">@Ui.Icon("alert")<p>@Error</p></div> }
</div>
<form method="post" class="form">
  <label>Setup token<input asp-for="Token" autocomplete="off" required /></label>
  <label>Username<input asp-for="Username" autocomplete="username" required /></label>
  <label>Password <small>At least 12 characters.</small><input asp-for="Password" type="password" autocomplete="new-password" required minlength="12" /></label>
  <div><button type="submit">Create administrator</button></div>
</form>
