@page "/repos/{id:guid}"
@inject IDbContextFactory<AppDbContext> Dbf
@inject RepositoryAdminService Admin
@inject RequestService Requests
@inject IOptions<AptOptions> Apt
@inject SettingsService Settings
@functions {
    public Repository Repo { get; set; } = new();
    public string[] Allow { get; set; } = [];
    public record PkgRow(string Package, string Version, string Architecture, string Channel, string State, string? Reason, bool Winner, string? Others);
    public List<PkgRow> Packages { get; set; } = [];
    public List<SyncRun> Runs { get; set; } = [];
    public List<ReleaseAsset> ProblemAssets { get; set; } = [];
    public List<Api.CoreApi.RequestRow> History { get; set; } = [];
    public string? ProposedBy { get; set; }
    [BindProperty] public string[] Archs { get; set; } = [];
    [BindProperty] public string? Note { get; set; }
    [BindProperty] public string? Reason { get; set; }
    [BindProperty] public bool IncludePrereleases { get; set; }
    [BindProperty] public int HoldbackHours { get; set; }
    [BindProperty] public int SourcePriority { get; set; }
    [BindProperty] public string? Notes { get; set; }
    [BindProperty] public string? AssetIncludeGlob { get; set; }
    [BindProperty] public string? AssetExcludeGlob { get; set; }

    private async Task<bool> LoadAsync(Guid id, CancellationToken ct)
    {
        await using var db = await Dbf.CreateDbContextAsync(ct);
        var r = await db.Repositories.AsNoTracking().FirstOrDefaultAsync(x => x.Id == id, ct);
        if (r is null) return false;
        Repo = r;
        Allow = await Settings.GetAsync<string[]>(SettingsService.ArchAllowList, ct) ?? Architectures.ParseList(Apt.Value.Architectures);
        ProposedBy = r.ProposedBy is null ? null : await db.Users.Where(u => u.Id == r.ProposedBy).Select(u => u.DisplayName).FirstOrDefaultAsync(ct);
        Runs = await db.SyncRuns.AsNoTracking().Where(s => s.RepositoryId == id).OrderByDescending(s => s.StartedAt).Take(10).ToListAsync(ct);
        ProblemAssets = await (from a in db.ReleaseAssets.AsNoTracking() join rel in db.Releases on a.ReleaseId equals rel.Id
                               where rel.RepositoryId == id && (a.State == AssetState.Failed || a.State == AssetState.Quarantined || a.State == AssetState.Excluded)
                               orderby a.ObservedAt descending select a).Take(30).ToListAsync(ct);
        Packages = await (from s in db.PackageSources.AsNoTracking() join v in db.PackageVariants on s.VariantId equals v.Id join p in db.Packages on v.PackageId equals p.Id
                          where s.RepositoryId == id orderby p.Name, v.Version
                          select new PkgRow(p.Name, v.Version, v.Architecture, v.Channel, v.State, v.QuarantineReason, s.IsWinner,
                              string.Join(", ", db.PackageSources.Where(o => o.VariantId == v.Id && o.Id != s.Id).Join(db.Repositories, o => o.RepositoryId, rr => rr.Id, (o, rr) => rr.FullName)))).Take(500).ToListAsync(ct);
        History = await Api.CoreApi.RequestQuery(db, r => r.RepositoryId == id).OrderByDescending(x => x.CreatedAt).Take(20).ToListAsync(ct);
        Archs = Repo.Architectures; IncludePrereleases = Repo.IncludePrereleases; HoldbackHours = Repo.HoldbackHours; SourcePriority = Repo.SourcePriority;
        Notes = Repo.Notes; AssetIncludeGlob = Repo.AssetIncludeGlob; AssetExcludeGlob = Repo.AssetExcludeGlob;
        return true;
    }

    public async Task<IActionResult> OnGetAsync(Guid id, CancellationToken ct) => await LoadAsync(id, ct) ? Page() : NotFound();

    private async Task<IActionResult> Run(Guid id, Func<Guid, Task<string>> action)
    {
        try { TempData["Flash"] = await action(User.RequireId()); }
        catch (ServiceException e) { TempData["Error"] = e.Message; }
        return RedirectToPage(new { id });
    }

    public Task<IActionResult> OnPostRequestArchAsync(Guid id, CancellationToken ct) => Run(id, async uid =>
    {
        await Requests.CreateAsync(uid, new CreateRequestInput(RequestKind.AddArch, null, null, null, id, Archs, Note), ct);
        return "Architecture request submitted for approval.";
    });
    public Task<IActionResult> OnPostSaveAsync(Guid id, CancellationToken ct) => Run(id, async uid =>
    {
        EnsureAdmin();
        await Admin.PatchAsync(id, uid, new RepoPatch(Archs, IncludePrereleases, HoldbackHours, AssetIncludeGlob, AssetExcludeGlob, null, null, Notes, SourcePriority), ct);
        return "Saved.";
    });
    public Task<IActionResult> OnPostStateAsync(Guid id, string action, CancellationToken ct) => Run(id, async uid =>
    {
        EnsureAdmin();
        await Admin.SetStateAsync(id, uid, action, Reason, ct);
        return $"Repository {action} done.";
    });
    public Task<IActionResult> OnPostSyncAsync(Guid id, CancellationToken ct) => Run(id, async uid => { EnsureAdmin(); await Admin.EnqueueSyncAsync(id, uid, false, ct); return "Sync queued."; });
    public Task<IActionResult> OnPostRearbitrateAsync(Guid id, CancellationToken ct) => Run(id, async uid => { EnsureAdmin(); return $"Re-arbitrated {await Admin.RearbitrateAsync(id, uid, ct)} package(s)."; });
    private void EnsureAdmin() { if (!User.IsAdmin()) throw new ServiceException("forbidden", "Admin role required.", 403); }
}
@{ ViewData["Title"] = Repo.FullName; var admin = User.IsAdmin(); var canRequest = Repo.State is "active" or "paused"; var missing = Allow.Except(Repo.Architectures).ToList(); }
<div class="page-head">
  <div class="titles">
    <h1><span class="muted">@Repo.Owner/</span>@Repo.Name</h1>
    <div class="row">
      @Ui.Pill(Repo.State)
      @if (Repo.ConsecutiveFailures >= 5) { @Ui.Pill("stale") }
      @if (Repo.IsArchived) { <span class="pill pill-quiet">@Ui.Icon("archive")Archived on GitHub</span> }
    </div>
    @if (!string.IsNullOrWhiteSpace(Repo.Description)) { <p class="lede">@Repo.Description</p> }
  </div>
  <div class="actions"><a class="btn secondary" href="@Repo.HtmlUrl" rel="noopener noreferrer">View on GitHub @Ui.Icon("external")</a></div>
</div>

@if (!string.IsNullOrEmpty(Repo.StateReason)) { <div class="notice error">@Ui.Icon("info")<p><strong>@(Repo.State == "blocked" ? "Blocked" : Repo.State == "rejected" ? "Not approved" : "Note"):</strong> @Repo.StateReason</p></div> }
@if (Repo.State == "proposed") { <div class="notice warn">@Ui.Icon("hourglass")<p><strong>Waiting for an administrator.</strong> The latest releases have been inspected so the reviewer can see what this project publishes, but nothing is published to apt until it is approved.</p></div> }

<dl class="facts">
  <div><dt>Architectures</dt><dd>@Ui.Arches(Repo.Architectures)</dd></div>
  <div><dt>Prereleases</dt><dd>@(Repo.IncludePrereleases ? "Published to the testing suite" : "Ignored")</dd></div>
  <div><dt>New releases appear</dt><dd>@(Repo.HoldbackHours == 0 ? "Straight away" : $"After {Repo.HoldbackHours} h holdback")</dd></div>
  <div><dt>Requested by</dt><dd>@(ProposedBy ?? "an administrator")<small>@Ui.Ago(Repo.CreatedAt)</small></dd></div>
  <div><dt>Licence</dt><dd>@(Repo.LicenseSpdx ?? "Not declared")</dd></div>
  <div><dt>Last sync</dt><dd>@Ui.Ago(Repo.LastSyncedAt)<small>@(Repo.LastSyncStatus is null ? "" : Ui.Cap(Repo.LastSyncStatus))@(Repo.State == "active" ? (Repo.LastSyncStatus is null ? "Next sync " : ", next sync ") + Ui.UntilText(Repo.NextSyncAt) : "")</small></dd></div>
</dl>

<nav class="anchors" aria-label="On this page">
  <a href="#packages">Packages (@Packages.Count)</a>
  @if (ProblemAssets.Count > 0) { <a href="#assets">Skipped files (@ProblemAssets.Count)</a> }
  <a href="#syncs">Syncs</a>
  <a href="#history">Requests</a>
  @if (canRequest) { <a href="#more-archs">Ask for an architecture</a> }
  @if (admin) { <a href="#manage">Manage</a> }
</nav>

<section class="section" id="packages" aria-labelledby="h-packages">
  <div class="section-head"><h2 id="h-packages">Packages</h2><span class="muted">What this project contributes to the apt repository.</span></div>
  @if (Packages.Count == 0)
  {
    <div class="empty">@Ui.Icon("box")<h3>No packages yet</h3><p>Nothing has been ingested from this repository's releases. Check the sync results below.</p></div>
  }
  else
  {
    <div class="tablewrap"><table>
      <thead><tr><th>Package</th><th>Version</th><th>Arch</th><th>Channel</th><th>Status</th><th>In the apt index</th></tr></thead>
      <tbody>
      @foreach (var p in Packages)
      {
        <tr>
          <td><strong>@p.Package</strong></td><td><span class="ver">@p.Version</span></td><td>@p.Architecture</td><td>@Ui.Cap(p.Channel)</td>
          <td>@Ui.Pill(p.State)@if (p.Reason is not null) { <small class="reason">@Ui.Cap(p.Reason)</small> }</td>
          <td>@if (p.State == "quarantined") { <span class="muted">Held for review</span> } else if (Repo.State is "proposed" or "rejected" or "blocked") { <span class="muted">Not published</span> } else if (p.Winner) { <span>Yes</span> } else { <span class="muted">No: another repository's file is used</span> }@if (!string.IsNullOrEmpty(p.Others)) { <small class="muted"> Also offered by @p.Others</small> }</td>
        </tr>
      }
      </tbody>
    </table></div>
  }
</section>

@if (ProblemAssets.Count > 0)
{
  <section class="section" id="assets" aria-labelledby="h-assets">
    <div class="section-head"><h2 id="h-assets">Skipped and failed files</h2><span class="muted">Release files that were not turned into packages, and why.</span></div>
    <div class="tablewrap"><table>
      <thead><tr><th>File</th><th>Result</th><th>Reason</th></tr></thead>
      <tbody>
      @foreach (var a in ProblemAssets) { <tr><td class="ver">@a.Name</td><td>@Ui.Pill(a.State)</td><td>@Ui.Cap(a.ExcludedReason ?? a.FailureReason ?? "")</td></tr> }
      </tbody>
    </table></div>
  </section>
}

<section class="section" id="syncs" aria-labelledby="h-syncs">
  <div class="section-head"><h2 id="h-syncs">Recent syncs</h2></div>
  @if (Runs.Count == 0) { <p class="muted">No sync has run yet.</p> }
  else
  {
    <div class="tablewrap"><table>
      <thead><tr><th>Started</th><th>Trigger</th><th>Result</th><th class="num">Ingested</th><th class="num">Skipped</th><th class="num">Failed</th><th class="num">Conflicts</th></tr></thead>
      <tbody>
      @foreach (var s in Runs)
      {
        <tr><td class="nowrap">@Ui.Ago(s.StartedAt)</td><td>@Ui.Cap(s.Trigger)</td><td>@Ui.Pill(s.Status)@if (s.ErrorCategory is not null) { <span class="muted"> @Ui.Cap(s.ErrorCategory)</span> }</td>
            <td class="num">@s.AssetsIngested</td><td class="num">@s.AssetsExcluded</td><td class="num">@s.AssetsFailed</td><td class="num">@s.ConflictsFound</td></tr>
      }
      </tbody>
    </table></div>
  }
</section>

<section class="section" id="history" aria-labelledby="h-history">
  <div class="section-head"><h2 id="h-history">Requests for this repository</h2></div>
  @if (History.Count == 0) { <p class="muted">No requests recorded.</p> }
  else
  {
    <div class="tablewrap"><table>
      <thead><tr><th>Asked</th><th>By</th><th>Request</th><th>Architectures</th><th>Status</th><th>Decision</th></tr></thead>
      <tbody>
      @foreach (var h in History)
      {
        <tr><td class="nowrap">@Ui.Ago(h.CreatedAt)</td><td>@h.RequestedBy</td><td>@(h.Kind == "add_repo" ? "Add repository" : "Add architectures")</td><td>@Ui.Arches(h.Architectures)</td><td>@Ui.Pill(h.Status)</td><td>@h.DecisionNote</td></tr>
      }
      </tbody>
    </table></div>
  }
</section>

@if (canRequest)
{
  <section class="section" id="more-archs" aria-labelledby="h-arch">
    <div class="section-head"><h2 id="h-arch">Request another architecture</h2></div>
    @if (missing.Count == 0) { <p class="muted">Every architecture this server supports is already enabled for this repository.</p> }
    else
    {
      <form method="post" asp-page-handler="RequestArch" class="stack">
        <fieldset>
          <legend>Architectures to add</legend>
          <div class="chips">@foreach (var a in missing) { <label class="chip"><input type="checkbox" name="Archs" value="@a" /><span>@a</span></label> }</div>
        </fieldset>
        <label>Why do you need it? <small>Optional.</small><input asp-for="Note" maxlength="1000" /></label>
        <div><button type="submit">Submit request</button></div>
      </form>
    }
  </section>
}

@if (admin)
{
  <details class="manage" id="manage">
    <summary>@Ui.Icon("sliders")Manage this repository</summary>
    <div class="body">
      <form method="post" asp-page-handler="Save" class="stack">
        <fieldset>
          <legend>Architectures</legend>
          <div class="chips">@foreach (var a in Allow.Union(Repo.Architectures)) { <label class="chip"><input type="checkbox" name="Archs" value="@a" checked="@Archs.Contains(a)" /><span>@a</span></label> }</div>
        </fieldset>
        <label class="inline"><input type="checkbox" asp-for="IncludePrereleases" /> Publish prereleases to the testing suite</label>
        <label>Hold new releases back for (hours) <small>0 publishes straight away. A holdback gives you time to notice a bad upstream release.</small><input asp-for="HoldbackHours" type="number" min="0" max="720" /></label>
        <label>Source priority <small>When two repositories ship the same package version, the higher priority wins after "Re-arbitrate".</small><input asp-for="SourcePriority" type="number" /></label>
        <label>Files to include <small>Comma-separated patterns.</small><input asp-for="AssetIncludeGlob" /></label>
        <label>Files to exclude<input asp-for="AssetExcludeGlob" /></label>
        <label>Notes for administrators<textarea asp-for="Notes" rows="2"></textarea></label>
        <div><button type="submit">Save changes</button></div>
      </form>
      <div class="row">
        <form method="post" asp-page-handler="Sync"><button class="secondary" type="submit">Sync now</button></form>
        <form method="post" asp-page-handler="Rearbitrate"><button class="secondary" type="submit">Re-arbitrate packages</button></form>
      </div>
      <div class="panel danger-zone">
        <h3>State</h3>
        <p class="muted">Pausing keeps published packages but stops syncing. Removing keeps them for the grace period. Blocking removes them from the next index.</p>
        <div class="row">
        @foreach (var act in new[] { ("pause", "active"), ("resume", "paused"), ("remove", ""), ("block", ""), ("unblock", "blocked"), ("reinstate", "removed"), ("activate", "proposed"), ("activate", "rejected") })
        {
          if (act.Item2 == "" || act.Item2 == Repo.State)
          {
            <form method="post" asp-page-handler="State" asp-route-action="@act.Item1" class="row">
              <label class="sr-only" for="reason-@act.Item1">Reason for @act.Item1</label>
              <input id="reason-@act.Item1" name="Reason" placeholder="Reason (optional)" class="w14" />
              <button class="@(act.Item1 is "block" or "remove" ? "danger" : "secondary")" type="submit">@Ui.Cap(act.Item1)</button>
            </form>
          }
        }
        </div>
      </div>
    </div>
  </details>
}
