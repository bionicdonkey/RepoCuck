@page "/repos"
@inject IDbContextFactory<AppDbContext> Dbf
@functions {
    public record Row(Guid Id, string Owner, string Name, string? Description, string State, string[] Architectures, bool IsArchived, DateTimeOffset? LastSyncedAt, string? LastSyncStatus, int Packages, bool Stale);
    public List<Row> Rows { get; set; } = [];
    public Dictionary<string, int> Counts { get; set; } = [];
    public int Total { get; set; }
    [BindProperty(SupportsGet = true)] public string? State { get; set; }
    [BindProperty(SupportsGet = true)] public string? Q { get; set; }

    public async Task OnGetAsync(CancellationToken ct)
    {
        await using var db = await Dbf.CreateDbContextAsync(ct);
        Counts = await db.Repositories.AsNoTracking().GroupBy(r => r.State).Select(g => new { g.Key, N = g.Count() }).ToDictionaryAsync(x => x.Key, x => x.N, ct);
        Total = Counts.Values.Sum();
        var q = db.Repositories.AsNoTracking().AsQueryable();
        if (!string.IsNullOrEmpty(State)) q = q.Where(r => r.State == State);
        if (!string.IsNullOrWhiteSpace(Q)) { var like = "%" + Q.Trim().Replace("%", "").Replace("_", "") + "%"; q = q.Where(r => EF.Functions.ILike(r.FullName, like)); }
        Rows = await q.OrderBy(r => r.FullName).Take(500).Select(r => new Row(r.Id, r.Owner, r.Name, r.Description, r.State, r.Architectures, r.IsArchived, r.LastSyncedAt, r.LastSyncStatus,
            db.PackageSources.Count(s => s.RepositoryId == r.Id && s.IsWinner), r.ConsecutiveFailures >= 5)).ToListAsync(ct);
    }
}
@{ ViewData["Title"] = "Repositories"; var admin = User.IsInRole("admin"); }
<div class="page-head">
  <div class="titles">
    <h1>Repositories</h1>
    <p class="lede">The GitHub projects this mirror watches, and the packages each one publishes.</p>
  </div>
  <div class="actions">
    @if (admin) { <a class="btn secondary" href="/admin/repositories">@Ui.Icon("plus")Add directly</a> }
    <a class="btn" href="/requests/new">@Ui.Icon("plus")Request a repository</a>
  </div>
</div>

@await Component.InvokeAsync("InstallStrip")

<form method="get" class="toolbar" role="search">
  <div class="search">
    @Ui.Icon("search")
    <label class="sr-only" for="q">Search repositories</label>
    <input id="q" name="q" value="@Q" type="search" placeholder="Search by owner or name" data-filter="#ledger > .entry" autocomplete="off" />
  </div>
  @if (!string.IsNullOrEmpty(State)) { <input type="hidden" name="state" value="@State" /> }
  <noscript><button class="secondary" type="submit">Search</button></noscript>
  <nav class="filters" aria-label="Filter by state">
    <a href="/repos@(string.IsNullOrEmpty(Q) ? "" : "?q=" + Uri.EscapeDataString(Q))" aria-current="@(string.IsNullOrEmpty(State) ? "true" : "false")">All <span class="n">@Total</span></a>
    @foreach (var s in new[] { "active", "proposed", "paused", "rejected", "blocked", "removed" })
    {
      if (!Counts.TryGetValue(s, out var n) && State != s) { continue; }
      <a href="/repos?state=@s@(string.IsNullOrEmpty(Q) ? "" : "&q=" + Uri.EscapeDataString(Q))" aria-current="@(State == s ? "true" : "false")">@(s == "proposed" ? "Awaiting approval" : Ui.Cap(s)) <span class="n">@n</span></a>
    }
  </nav>
</form>

@if (Rows.Count == 0)
{
  <div class="empty">
    @Ui.Icon("box")
    @if (Total == 0)
    {
      <h3>No repositories yet</h3>
      <p>Request a GitHub project that publishes <code>.deb</code> files in its releases. Once an administrator approves it, its packages appear here and in the apt repository.</p>
      <a class="btn" href="/requests/new">Request the first repository</a>
    }
    else
    {
      <h3>Nothing matches that filter</h3>
      <p>Try a different search, or clear the state filter.</p>
      <a class="btn secondary" href="/repos">Show all repositories</a>
    }
  </div>
}
else
{
  <div class="ledger-head" aria-hidden="true"><span>Repository</span><span>State</span><span>Architectures</span><span>Packages</span><span>Last sync</span></div>
  <ul class="ledger" id="ledger">
  @foreach (var r in Rows)
  {
    <li class="entry">
      <div class="name">
        <a href="/repos/@r.Id"><span class="owner">@r.Owner/</span>@r.Name</a>
        @if (!string.IsNullOrWhiteSpace(r.Description)) { <p>@r.Description</p> }
      </div>
      <div class="cell">@Ui.Pill(r.State) @if (r.Stale) { @Ui.Pill("stale") }</div>
      <div class="cell">@Ui.Arches(r.Architectures)</div>
      <div class="cell metric"><b>@r.Packages</b> <span class="muted">@(r.Packages == 1 ? "package" : "packages")</span></div>
      <div class="cell when">@if (r.LastSyncStatus == "failed") { <span class="muted">Failed </span> }@Ui.Ago(r.LastSyncedAt)</div>
    </li>
  }
  </ul>
}
