@page
@inject UserService Users
@inject IOptions<AuthOptions> Auth
@inject IAuditService Audit
@inject SetupTokenService Setup
@inject IDbContextFactory<AppDbContext> Dbf
@functions {
    [BindProperty] public string Username { get; set; } = "";
    [BindProperty] public string Password { get; set; } = "";
    [BindProperty] public string? TotpCode { get; set; }
    [BindProperty(SupportsGet = true)] public string? ReturnUrl { get; set; }
    public string? Error { get; set; }
    public bool NeedTotp { get; set; }
    public bool NeedSetup { get; set; }
    public List<(string Slug, string Name)> Providers { get; set; } = [];
    [BindProperty(SupportsGet = true)] public string? ErrorMessage { get; set; }

    public async Task<IActionResult> OnGetAsync(CancellationToken ct)
    {
        if (User.Identity?.IsAuthenticated == true) return LocalRedirect("/repos");
        NeedSetup = Setup.IsActive && !await Users.AnyUsersAsync(ct);
        await LoadProviders(ct);
        return Page();
    }

    private async Task LoadProviders(CancellationToken ct)
    {
        await using var db = await Dbf.CreateDbContextAsync(ct);
        Providers = (await db.IdentityProviders.AsNoTracking().Where(p => p.Enabled).OrderBy(p => p.DisplayName).Select(p => new { p.Slug, p.DisplayName }).ToListAsync(ct))
            .Select(p => (p.Slug, p.DisplayName)).ToList();
    }

    public async Task<IActionResult> OnPostAsync(CancellationToken ct)
    {
        var r = await Users.LoginAsync(Username, Password, TotpCode, HttpContext.Connection.RemoteIpAddress, HttpContext.TraceIdentifier, ct);
        if (!r.Success) { Error = r.Error; NeedTotp = r.TotpRequired; await LoadProviders(ct); return Page(); }
        await AuthSetup.SignInAsync(HttpContext, r.User!, Auth.Value);
        if (r.User!.MustChangePassword) return LocalRedirect("/account?mustChange=1");
        return LocalRedirect(Url.IsLocalUrl(ReturnUrl) ? ReturnUrl! : "/repos");
    }
}
@{ Layout = "_AuthLayout"; ViewData["Title"] = "Sign in"; }
<div class="stack">
  <h1>Sign in</h1>
  @if (NeedSetup) { <div class="notice warn">@Ui.Icon("info")<p>First run: <a href="/setup">create the first administrator</a> with the setup token from the server's console.</p></div> }
  @if (Error is not null) { <div class="notice error" role="alert">@Ui.Icon("alert")<p>@Error</p></div> }
  @if (Request.Query["error"].ToString() is { Length: > 0 } qe) { <div class="notice error" role="alert">@Ui.Icon("alert")<p>@qe</p></div> }
</div>
<form method="post" class="form">
  <input type="hidden" asp-for="ReturnUrl" />
  <label>Username<input asp-for="Username" autocomplete="username" required autofocus /></label>
  <label>Password<input asp-for="Password" type="password" autocomplete="current-password" required /></label>
  @if (NeedTotp || !string.IsNullOrEmpty(TotpCode))
  { <label>Verification code <small>From your authenticator app, or one of your recovery codes.</small><input asp-for="TotpCode" autocomplete="one-time-code" inputmode="numeric" /></label> }
  <div><button type="submit">Sign in</button></div>
</form>
@if (Providers.Count > 0)
{
  <div class="divider">or</div>
  <div class="sso">
    @foreach (var p in Providers) { <a class="btn secondary" href="/auth/oidc/@p.Slug/signin?returnUrl=@Uri.EscapeDataString(ReturnUrl ?? "/repos")">@Ui.Icon("login")Continue with @p.Name</a> }
  </div>
}
