@page "/admin/audit"
@inject IDbContextFactory<AppDbContext> Dbf
@functions {
    public List<AuditEntry> Rows { get; set; } = [];
    [BindProperty(SupportsGet = true)] public string? Action { get; set; }
    [BindProperty(SupportsGet = true)] public int Skip { get; set; }
    public async Task OnGetAsync(CancellationToken ct)
    {
        await using var db = await Dbf.CreateDbContextAsync(ct);
        var q = db.AuditLog.AsNoTracking().AsQueryable();
        if (!string.IsNullOrWhiteSpace(Action)) { var a = Action.Trim(); q = q.Where(x => x.Action.StartsWith(a)); }
        Rows = await q.OrderByDescending(x => x.Id).Skip(Math.Max(0, Skip)).Take(100).ToListAsync(ct);
    }
}
@{ ViewData["Title"] = "Audit log"; }
<div class="page-head">
  <div class="titles"><h1>Audit log</h1><p class="lede">Every sign-in, decision and configuration change, newest first. Entries cannot be edited or deleted.</p></div>
  <div class="actions"><a class="btn secondary" href="/api/v1/admin/audit?format=csv&limit=10000">Export CSV</a></div>
</div>
<form method="get" class="toolbar">
  <label class="sr-only" for="action">Action starts with</label>
  <input id="action" name="action" value="@Action" placeholder="Filter by action, e.g. request." class="w14" />
  <button class="secondary" type="submit">Filter</button>
</form>
<div class="tablewrap"><table>
  <thead><tr><th>When</th><th>Who</th><th>Action</th><th>Target</th><th>Outcome</th><th>Details</th></tr></thead>
  <tbody>
  @foreach (var r in Rows)
  {
    <tr><td class="nowrap">@Ui.Ago(r.OccurredAt)</td><td>@(r.ActorLabel ?? r.ActorUserId?.ToString()[..8])</td><td><code>@r.Action</code></td><td>@r.TargetType @r.TargetId</td>
        <td>@Ui.Pill(r.Outcome == "success" ? "succeeded" : r.Outcome == "denied" ? "blocked" : "failed", Ui.Cap(r.Outcome))</td><td><code>@r.Metadata</code></td></tr>
  }
  </tbody>
</table></div>
<div class="row section">@if (Skip > 0) { <a class="btn secondary" href="?action=@Action&skip=@Math.Max(0, Skip - 100)">Newer</a> } @if (Rows.Count == 100) { <a class="btn secondary" href="?action=@Action&skip=@(Skip + 100)">Older</a> }</div>
