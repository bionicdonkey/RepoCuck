@page "/admin/repositories"
@inject RepositoryAdminService Admin
@inject IOptions<AptOptions> Apt
@inject SettingsService Settings
@functions {
    public string[] Allow { get; set; } = [];
    [BindProperty] public string? Repository { get; set; }
    [BindProperty] public string[] Archs { get; set; } = [];
    public async Task OnGetAsync(CancellationToken ct) => Allow = await Settings.GetAsync<string[]>(SettingsService.ArchAllowList, ct) ?? Architectures.ParseList(Apt.Value.Architectures);
    public async Task<IActionResult> OnPostAsync(CancellationToken ct)
    {
        try
        {
            var r = await Admin.AddDirectAsync(User.RequireId(), null, null, Repository, Archs, ct);
            TempData["Flash"] = $"Added {r.FullName}.";
            return RedirectToPage("/Repos/Details", new { id = r.Id });
        }
        catch (ServiceException e) { TempData["Error"] = e.Message; return RedirectToPage(); }
    }
}
@{ ViewData["Title"] = "Add repository"; }
<div class="page-head">
  <div class="titles">
    <h1>Add a repository</h1>
    <p class="lede">Skip the request queue and start mirroring a project now. It becomes active immediately and its first sync is queued. Existing repositories are managed from their own page.</p>
  </div>
</div>
<form method="post" class="stack">
  <label>GitHub repository <input asp-for="Repository" placeholder="owner/name or https://github.com/owner/name" required autocomplete="off" /></label>
  <fieldset>
    <legend>Architectures to publish</legend>
    <div class="chips">@foreach (var a in Allow) { <label class="chip"><input type="checkbox" name="Archs" value="@a" checked="@(a == "amd64")" /><span>@a</span></label> }</div>
  </fieldset>
  <div class="row"><button type="submit">Add repository</button><a class="btn secondary" href="/repos">Cancel</a></div>
</form>
