@page "/admin/requests"
@inject IDbContextFactory<AppDbContext> Dbf
@inject RequestService Svc
@inject IOptions<AptOptions> Apt
@inject SettingsService Settings
@functions {
    public record Finding(string Package, string Version, string Architecture, string State, string? Reason);
    public record Group(Guid RepoId, string Name, string State, string[] Archs, string? Description, string? License, List<Api.CoreApi.RequestRow> Requests, List<Finding> Findings, int Assets, int Failed);
    public List<Group> Groups { get; set; } = [];
    public string[] Allow { get; set; } = [];
    [BindProperty] public string[] Archs { get; set; } = [];
    [BindProperty] public bool IncludePrereleases { get; set; }
    [BindProperty] public int HoldbackHours { get; set; }
    [BindProperty] public string? Reason { get; set; }
    [BindProperty] public string? DecisionNote { get; set; }

    public async Task OnGetAsync(CancellationToken ct)
    {
        Allow = await Settings.GetAsync<string[]>(SettingsService.ArchAllowList, ct) ?? Architectures.ParseList(Apt.Value.Architectures);
        await using var db = await Dbf.CreateDbContextAsync(ct);
        var reqs = await Api.CoreApi.RequestQuery(db, r => r.Status == RequestStatus.Pending).OrderBy(r => r.CreatedAt).ToListAsync(ct);
        foreach (var g in reqs.GroupBy(r => r.RepositoryId))
        {
            var repo = await db.Repositories.AsNoTracking().FirstAsync(r => r.Id == g.Key, ct);
            var findings = await (from s in db.PackageSources.AsNoTracking() join v in db.PackageVariants on s.VariantId equals v.Id join p in db.Packages on v.PackageId equals p.Id
                                  where s.RepositoryId == g.Key select new Finding(p.Name, v.Version, v.Architecture, v.State, v.QuarantineReason)).Take(50).ToListAsync(ct);
            var assets = await (from a in db.ReleaseAssets join rel in db.Releases on a.ReleaseId equals rel.Id where rel.RepositoryId == g.Key select a.State).ToListAsync(ct);
            Groups.Add(new Group(g.Key, repo.FullName, repo.State, repo.Architectures, repo.Description, repo.LicenseSpdx, g.ToList(), findings, assets.Count, assets.Count(a => a == AssetState.Failed)));
        }
    }

    private async Task<IActionResult> Run(Func<Task<string>> a)
    {
        try { TempData["Flash"] = await a(); } catch (ServiceException e) { TempData["Error"] = e.Message; }
        return RedirectToPage();
    }
    public Task<IActionResult> OnPostApproveAsync(Guid id, CancellationToken ct) => Run(async () =>
    {
        await Svc.ApproveAsync(id, User.RequireId(), new ApproveOverrides(Archs.Length == 0 ? null : Archs, IncludePrereleases, HoldbackHours, DecisionNote), ct);
        return "Approved.";
    });
    public Task<IActionResult> OnPostRejectAsync(Guid id, CancellationToken ct) => Run(async () => { await Svc.RejectAsync(id, User.RequireId(), Reason, ct); return "Rejected."; });
}
@{ ViewData["Title"] = "Approvals"; }
<div class="page-head">
  <div class="titles">
    <h1>Approvals</h1>
    <p class="lede">Review what each project publishes before it can reach your machines. Approved packages are installed as root, so look at the flagged ones first.</p>
  </div>
</div>
@if (Groups.Count == 0)
{
  <div class="empty">@Ui.Icon("check-circle")<h3>Nothing is waiting for approval</h3><p>New requests from members show up here, with the packages found in the project's latest releases.</p></div>
}
@foreach (var g in Groups)
{
  var flagged = g.Findings.Count(f => f.State == "quarantined");
  <section class="panel @(flagged > 0 ? "flagged" : "")" aria-labelledby="g-@g.RepoId">
    <div class="section-head">
      <h2 id="g-@g.RepoId"><a href="/repos/@g.RepoId">@g.Name</a></h2>
      @Ui.Pill(g.State)
      @if (flagged > 0) { <span class="pill pill-pending">@Ui.Icon("shield")@flagged flagged for review</span> }
    </div>
    @if (!string.IsNullOrWhiteSpace(g.Description)) { <p class="muted">@g.Description</p> }
    <dl class="facts">
      <div><dt>Licence</dt><dd>@(g.License ?? "Not declared")</dd></div>
      <div><dt>Release files inspected</dt><dd>@g.Assets@if (g.Failed > 0) { <small>@g.Failed could not be read</small> }</dd></div>
      <div><dt>Architectures requested so far</dt><dd>@Ui.Arches(g.Archs)</dd></div>
    </dl>

    <h3 class="section-sub">Packages found</h3>
    @if (g.Findings.Count == 0) { <p class="muted">Nothing inspected yet. The first sync may still be running; reload in a minute.</p> }
    else
    {
      <div class="tablewrap"><table>
        <thead><tr><th>Package</th><th>Version</th><th>Arch</th><th>Review</th></tr></thead>
        <tbody>
        @foreach (var f in g.Findings)
        {
          <tr><td><strong>@f.Package</strong></td><td><span class="ver">@f.Version</span></td><td>@f.Architecture</td>
              <td>@if (f.State == "quarantined") { <span class="pill pill-pending">@Ui.Icon("shield")@Ui.Cap(f.Reason ?? "flagged")</span> } else { <span class="muted">Looks fine</span> }</td></tr>
        }
        </tbody>
      </table></div>
    }

    @foreach (var r in g.Requests)
    {
      <div class="card" role="group" aria-label="Request from @r.RequestedBy">
        <p><strong>@r.RequestedBy</strong> asks to @(r.Kind == "add_repo" ? "add this repository" : "add architectures") <span class="muted">@Ui.Ago(r.CreatedAt)</span>
          <br />Architectures requested: @Ui.Arches(r.Architectures)</p>
        @if (!string.IsNullOrEmpty(r.Note)) { <p class="muted">“@r.Note”</p> }
        <div class="decision">
          <form method="post" asp-page-handler="Approve" asp-route-id="@r.Id" class="stack">
            <fieldset>
              <legend>Publish these architectures</legend>
              <div class="chips">@foreach (var a in Allow) { <label class="chip"><input type="checkbox" name="Archs" value="@a" checked="@(r.Architectures.Contains(a) || g.Archs.Contains(a))" /><span>@a</span></label> }</div>
            </fieldset>
            @if (r.Kind == "add_repo")
            {
              <label class="inline"><input type="checkbox" name="IncludePrereleases" value="true" /> Publish prereleases to the testing suite</label>
              <label>Hold new releases back for (hours)<input name="HoldbackHours" type="number" min="0" max="720" value="0" class="w5" /></label>
            }
            <div><button type="submit">@Ui.Icon("check")Approve</button></div>
          </form>
          <form method="post" asp-page-handler="Reject" asp-route-id="@r.Id" class="stack">
            <label>Reason for declining <small>The requester sees this.</small><input name="Reason" required maxlength="500" /></label>
            <div><button class="danger" type="submit">Decline</button></div>
          </form>
        </div>
      </div>
    }
  </section>
}
