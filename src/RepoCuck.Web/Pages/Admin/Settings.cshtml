@page "/admin/settings"
@inject SettingsService Settings
@inject IOptions<AptOptions> Apt
@inject IOptions<RetentionOptions> Ret
@inject IOptions<LimitsOptions> Lim
@inject IOptions<SecurityOptions> Sec
@inject ISigner Signer
@inject IAuditService Audit
@functions {
    [BindProperty] public string ArchAllow { get; set; } = "";
    [BindProperty] public string Reserved { get; set; } = "";
    public string Fingerprint { get; set; } = "";
    public DateTimeOffset? Expiry { get; set; }
    public async Task OnGetAsync(CancellationToken ct)
    {
        ArchAllow = string.Join(", ", await Settings.GetAsync<string[]>(SettingsService.ArchAllowList, ct) ?? Architectures.ParseList(Apt.Value.Architectures));
        Reserved = string.Join("\n", await Settings.GetAsync<string[]>(SettingsService.ReservedNames, ct) ?? []);
        try { await Signer.EnsureReadyAsync(ct); Fingerprint = Signer.Fingerprint; Expiry = await Signer.GetKeyExpiryAsync(ct); } catch { Fingerprint = "(unavailable)"; }
    }
    public async Task<IActionResult> OnPostAsync(CancellationToken ct)
    {
        var archs = Architectures.ParseList(ArchAllow);
        if (archs.Length == 0 || archs.Any(a => !System.Text.RegularExpressions.Regex.IsMatch(a, "^[a-z0-9][a-z0-9-]*$"))) { TempData["Error"] = "Invalid architecture list."; return RedirectToPage(); }
        await Settings.SetAsync(SettingsService.ArchAllowList, archs, User.Id(), ct);
        await Settings.SetAsync(SettingsService.ReservedNames, Reserved.Split(['\n', ',', ' '], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).Select(x => x.ToLowerInvariant()).Distinct().ToArray(), User.Id(), ct);
        await Audit.WriteAsync("settings.updated", User.Id(), "settings", null, ct: ct);
        TempData["Flash"] = "Settings saved.";
        return RedirectToPage();
    }
}
@{ ViewData["Title"] = "Settings"; }
<div class="page-head"><div class="titles"><h1>Settings</h1><p class="lede">Choices an administrator can change while the server is running. Deployment settings come from environment variables and are shown read-only below.</p></div></div>
<form method="post" class="stack">
  <label>Architectures this server may publish <small>Comma-separated, for example <code>amd64, arm64, armhf</code>. Members can only request architectures from this list.</small><input asp-for="ArchAllow" /></label>
  <label>Extra protected package names <small>One per line. These are added to the built-in list of distribution-critical names; a package using one of them is held for review.</small><textarea asp-for="Reserved" rows="5"></textarea></label>
  <div><button type="submit">Save settings</button></div>
</form>
<section class="section" aria-labelledby="h-key">
  <div class="section-head"><h2 id="h-key">Signing key</h2><a href="/admin/signing">Rotate or inspect</a></div>
  <dl class="facts">
    <div><dt>Fingerprint</dt><dd><code>@Fingerprint</code></dd></div>
    <div><dt>Expires</dt><dd>@(Expiry is null ? "Never" : Expiry.Value.ToString("d MMM yyyy"))</dd></div>
    <div><dt>Public key for clients</dt><dd><a href="/apt/repocuck.gpg">repocuck.gpg</a> (binary), <a href="/apt/repocuck.asc">repocuck.asc</a> (armored)</dd></div>
  </dl>
</section>
<section class="section" aria-labelledby="h-env">
  <div class="section-head"><h2 id="h-env">Deployment (read-only)</h2></div>
  <dl class="facts">
    <div><dt>Public scheme</dt><dd><code>@Sec.Value.PublicScheme</code></dd></div>
    <div><dt>Client address header</dt><dd><code>@Sec.Value.ClientIpHeader</code></dd></div>
    <div><dt>Trusted proxies</dt><dd>@(string.IsNullOrEmpty(Sec.Value.TrustedProxies) ? "None" : Sec.Value.TrustedProxies)</dd></div>
    <div><dt>Versions kept per package</dt><dd>@Ret.Value.VersionsPerPackage</dd></div>
    <div><dt>Removed repositories stay published</dt><dd>@Ret.Value.OrphanGraceDays days</dd></div>
    <div><dt>Request limits</dt><dd>@Lim.Value.PendingRequestsPerUser pending, @Lim.Value.RequestsPerHour per hour</dd></div>
  </dl>
</section>
