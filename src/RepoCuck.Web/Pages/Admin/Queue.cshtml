@page "/admin/queue"
@inject IDbContextFactory<AppDbContext> Dbf
@inject JobQueue Queue
@functions {
    public List<Job> Jobs { get; set; } = [];
    public async Task OnGetAsync(CancellationToken ct)
    {
        await using var db = await Dbf.CreateDbContextAsync(ct);
        Jobs = await db.Jobs.AsNoTracking().OrderByDescending(j => j.UpdatedAt).Take(100).ToListAsync(ct);
    }
    public async Task<IActionResult> OnPostRetryAsync(Guid id, CancellationToken ct)
    {
        await using var db = await Dbf.CreateDbContextAsync(ct);
        await db.Jobs.Where(j => j.Id == id && (j.State == JobState.Dead || j.State == JobState.Failed))
            .ExecuteUpdateAsync(s => s.SetProperty(j => j.State, JobState.Pending).SetProperty(j => j.Attempts, 0).SetProperty(j => j.RunAfter, DateTimeOffset.UtcNow), ct);
        return RedirectToPage();
    }
    public async Task<IActionResult> OnPostRebuildAsync(CancellationToken ct)
    {
        await Queue.EnqueueAsync(JobKind.RebuildApt, null, "rebuild", ct: ct);
        TempData["Flash"] = "Rebuild queued.";
        return RedirectToPage();
    }
}
@{ ViewData["Title"] = "Job queue"; }
<div class="page-head">
  <div class="titles"><h1>Job queue</h1><p class="lede">Background work: syncing repositories, publishing indexes and housekeeping. Failed jobs retry automatically; dead ones need you.</p></div>
  <div class="actions"><form method="post" asp-page-handler="Rebuild"><button class="secondary" type="submit">Rebuild APT indexes</button></form></div>
</div>
<div class="tablewrap"><table>
  <thead><tr><th>Job</th><th>State</th><th class="num">Attempts</th><th>Runs</th><th>Last error</th><th><span class="sr-only">Actions</span></th></tr></thead>
  <tbody>
  @foreach (var j in Jobs)
  {
    <tr><td>@j.Kind</td><td>@Ui.Pill(j.State)</td><td class="num">@j.Attempts of @j.MaxAttempts</td><td class="nowrap">@Ui.Ago(j.RunAfter)</td><td>@j.LastError</td>
        <td>@if (j.State is "dead" or "failed") { <form method="post" asp-page-handler="Retry" asp-route-id="@j.Id"><button class="secondary sm" type="submit">Retry</button></form> }</td></tr>
  }
  </tbody>
</table></div>
