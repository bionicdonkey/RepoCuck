@page "/admin/signing"
@inject ISigner Signer
@inject IAuditService Audit
@inject JobQueue Jobs
@functions {
    public IReadOnlyList<SigningKeyInfo> Keys { get; set; } = [];
    public bool InProgress => Signer.ActiveFingerprints.Count > 1;
    public async Task OnGetAsync(CancellationToken ct)
    {
        await Signer.EnsureReadyAsync(ct);
        Keys = await Signer.ListKeysAsync(ct);
    }
    public async Task<IActionResult> OnPostAsync(string action, CancellationToken ct)
    {
        try
        {
            if (action == "start") { var f = await Signer.StartRotationAsync(ct); await Audit.WriteAsync("signing.rotation_started", User.Id(), "signing", f, ct: ct); TempData["Flash"] = "Rotation started: indices are now signed by both keys."; }
            else if (action == "complete") { await Signer.CompleteRotationAsync(ct); await Audit.WriteAsync("signing.rotation_completed", User.Id(), "signing", Signer.Fingerprint, ct: ct); TempData["Flash"] = "Rotation completed: only the new key signs now."; }
            await Jobs.EnqueueAsync(JobKind.RebuildApt, null, "rebuild", ct: ct);
        }
        catch (InvalidOperationException e) { TempData["Error"] = e.Message; }
        return RedirectToPage();
    }
}
@{ ViewData["Title"] = "Signing key"; }
<div class="page-head"><div class="titles"><h1>Signing key</h1><p class="lede">Every machine trusts this key. Rotating it is safe: for a while the repository is signed with both keys, so machines that haven't fetched the new one keep working.</p></div></div>
<div class="tablewrap"><table>
  <thead><tr><th>Fingerprint</th><th>Expires</th><th>Signing</th></tr></thead>
  <tbody>@foreach (var k in Keys) { <tr><td><code>@k.Fingerprint</code></td><td>@(k.Expires?.ToString("d MMM yyyy") ?? "Never")</td><td>@Ui.Pill(k.Active ? "active" : "removed", k.Active ? "In use" : "Not in use")</td></tr> }</tbody>
</table></div>
<p class="section">Clients fetch the key from <a href="/apt/repocuck.gpg">repocuck.gpg</a> (binary) or <a href="/apt/repocuck.asc">repocuck.asc</a> (armored). During a rotation the file contains both keys.</p>
<section class="section" aria-labelledby="h-rot">
  <div class="section-head"><h2 id="h-rot">Rotation</h2></div>
  @if (!InProgress)
  {
    <p>Start a rotation to generate a new key and sign with both. Wait at least a week for machines to refresh their keyring, then complete it.</p>
    <form method="post"><button type="submit" name="action" value="start">Start rotation</button></form>
  }
  else
  {
    <div class="notice warn">@Ui.Icon("info")<p>A rotation is in progress. The repository is signed with both keys. Complete it once machines have the new key; the old key is then deleted.</p></div>
    <form method="post"><button type="submit" name="action" value="complete" class="danger">Complete rotation and drop the old key</button></form>
  }
</section>
