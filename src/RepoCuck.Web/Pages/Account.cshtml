@page "/account"
@inject UserService Users
@inject IOptions<AuthOptions> AuthOpt
@inject IDbContextFactory<AppDbContext> Dbf
@inject ExternalLoginService Ext
@inject IAuthenticationSchemeProvider Schemes
@functions {
    public User Me { get; set; } = new();
    public List<(string Slug, string Name, bool Linked)> Providers { get; set; } = [];
    [BindProperty] public string? Current { get; set; }
    [BindProperty] public string NewPassword { get; set; } = "";
    [BindProperty] public string? Password { get; set; }
    [BindProperty] public string? Code { get; set; }
    public string? Secret { get; set; }
    public string? OtpUri { get; set; }
    public string[]? Recovery { get; set; }
    [BindProperty(SupportsGet = true)] public bool MustChange { get; set; }

    private async Task Load(CancellationToken ct)
    {
        Me = await Users.FindAsync(User.RequireId(), ct) ?? new User();
        await using var db = await Dbf.CreateDbContextAsync(ct);
        var linked = await db.ExternalIdentities.AsNoTracking().Where(e => e.UserId == Me.Id).Select(e => e.ProviderId).ToListAsync(ct);
        Providers = (await db.IdentityProviders.AsNoTracking().Where(p => p.Enabled || linked.Contains(p.Id)).OrderBy(p => p.DisplayName).ToListAsync(ct))
            .Select(p => (p.Slug, p.DisplayName, linked.Contains(p.Id))).ToList();
    }
    public Task OnGetAsync(CancellationToken ct) => Load(ct);

    public async Task<IActionResult> OnPostLinkAsync(string slug)
    {
        var name = OidcSchemeManager.SchemeName(slug);
        if (await Schemes.GetSchemeAsync(name) is null) return NotFound();
        var props = new AuthenticationProperties { RedirectUri = "/account" };
        props.Items["rc_link"] = User.RequireId().ToString();      // handled in OidcSchemeManager: re-authenticates (prompt=login) and links
        return Challenge(props, name);
    }

    public Task<IActionResult> OnPostUnlinkAsync(string slug, CancellationToken ct) => Run(() => Ext.UnlinkAsync(User.RequireId(), slug, ct), "Provider unlinked.", ct);

    private async Task<IActionResult> Run(Func<Task> action, string ok, CancellationToken ct)
    {
        try { await action(); TempData["Flash"] = ok; }
        catch (ServiceException e) { TempData["Error"] = e.Message; }
        return RedirectToPage();
    }
    public async Task<IActionResult> OnPostPasswordAsync(CancellationToken ct)
    {
        try
        {
            await Users.ChangePasswordAsync(User.RequireId(), Current, NewPassword, false, ct);
            var u = await Users.FindAsync(User.RequireId(), ct);
            await HttpContext.SignOutAsync(AuthSetup.Scheme);
            await AuthSetup.SignInAsync(HttpContext, u!, AuthOpt.Value);
            TempData["Flash"] = "Password changed.";
        }
        catch (ServiceException e) { TempData["Error"] = e.Message; }
        return RedirectToPage();
    }
    public async Task<IActionResult> OnPostTotpStartAsync(CancellationToken ct)
    {
        await Load(ct);
        try { (Secret, OtpUri) = await Users.BeginTotpAsync(User.RequireId(), Password ?? "", ct); }
        catch (ServiceException e) { TempData["Error"] = e.Message; return RedirectToPage(); }
        return Page();
    }
    public async Task<IActionResult> OnPostTotpConfirmAsync(CancellationToken ct)
    {
        await Load(ct);
        try { Recovery = await Users.ConfirmTotpAsync(User.RequireId(), Code ?? "", ct); }
        catch (ServiceException e) { TempData["Error"] = e.Message; return RedirectToPage(); }
        return Page();
    }
    public Task<IActionResult> OnPostTotpDisableAsync(CancellationToken ct) => Run(() => Users.DisableTotpAsync(User.RequireId(), Password ?? "", ct), "Two-factor authentication disabled.", ct);
    public async Task<IActionResult> OnPostRevokeAsync(CancellationToken ct)
    {
        await Users.RevokeSessionsAsync(User.RequireId(), ct);
        await HttpContext.SignOutAsync(AuthSetup.Scheme);
        return LocalRedirect("/login");
    }
}
@{ ViewData["Title"] = "Account and security"; }
<div class="page-head"><div class="titles"><h1>Account and security</h1><p class="lede">@Me.DisplayName, signed in as <code>@Me.Username</code> (@(Me.Role == "admin" ? "administrator" : "member")).</p></div></div>
@if (MustChange || Me.MustChangePassword) { <div class="notice warn" role="alert">@Ui.Icon("alert")<p><strong>Choose a new password to continue.</strong> Your administrator set a temporary one.</p></div> }
@if (Request.Query["linked"].Count > 0) { <div class="flash" role="status">Provider linked.</div> }
@if (Request.Query["linkError"].ToString() is { Length: > 0 } le) { <div class="notice error" role="alert">@Ui.Icon("alert")<p>@le</p></div> }

<section class="section" aria-labelledby="h-pw">
  <div class="section-head"><h2 id="h-pw">Password</h2></div>
  <form method="post" asp-page-handler="Password" class="stack">
    <label>Current password<input asp-for="Current" type="password" autocomplete="current-password" /></label>
    <label>New password <small>At least 12 characters. A passphrase works well.</small><input asp-for="NewPassword" type="password" autocomplete="new-password" minlength="12" required /></label>
    <div><button type="submit">Change password</button></div>
  </form>
</section>

<section class="section" aria-labelledby="h-2fa">
  <div class="section-head"><h2 id="h-2fa">Two-factor authentication</h2>@Ui.Pill(Me.TotpEnabled ? "enabled" : "disabled", Me.TotpEnabled ? "On" : "Off")</div>
  @if (Recovery is not null)
  {
    <div class="notice warn">@Ui.Icon("key")<p><strong>Save these recovery codes now.</strong> Each works once if you lose your authenticator, and they are shown only this time.</p></div>
    <div class="codeblock"><pre id="recovery" data-copy-text="@string.Join("\n", Recovery)"><code>@string.Join("\n", Recovery)</code></pre><button type="button" class="copy secondary sm" data-copy-target="#recovery" hidden>@Ui.Icon("copy")<span class="label">Copy</span></button></div>
  }
  else if (Secret is not null)
  {
    <p>Add this key to an authenticator app (time-based, six digits), then enter the code it shows.</p>
    <pre><code>@Secret</code></pre>
    <p class="muted">Or open this link on your phone: <code>@OtpUri</code></p>
    <form method="post" asp-page-handler="TotpConfirm" class="stack"><label>Code from the app<input asp-for="Code" inputmode="numeric" autocomplete="one-time-code" required /></label><div><button type="submit">Turn on two-factor</button></div></form>
  }
  else if (Me.TotpEnabled)
  {
    <p>Sign-in asks for a code from your authenticator app.</p>
    <form method="post" asp-page-handler="TotpDisable" class="stack"><label>Confirm with your password<input asp-for="Password" type="password" required /></label><div><button class="danger" type="submit">Turn off two-factor</button></div></form>
  }
  else
  {
    <p>Add a second step to sign-in. You'll need an authenticator app.</p>
    <form method="post" asp-page-handler="TotpStart" class="stack"><label>Confirm with your password<input asp-for="Password" type="password" required /></label><div><button type="submit">Set up two-factor</button></div></form>
  }
</section>

@if (Providers.Count > 0)
{
  <section class="section" aria-labelledby="h-sso">
    <div class="section-head"><h2 id="h-sso">Linked sign-in providers</h2></div>
    <div class="tablewrap"><table><tbody>
    @foreach (var p in Providers)
    {
      <tr><td><strong>@p.Name</strong></td><td>@Ui.Pill(p.Linked ? "active" : "quiet", p.Linked ? "Linked" : "Not linked")</td><td>
        @if (p.Linked) { <form method="post" asp-page-handler="Unlink" asp-route-slug="@p.Slug"><button class="secondary sm" type="submit">Unlink</button></form> }
        else { <form method="post" asp-page-handler="Link" asp-route-slug="@p.Slug"><button class="secondary sm" type="submit">Link (asks you to sign in again)</button></form> }
      </td></tr>
    }
    </tbody></table></div>
  </section>
}

<section class="section" aria-labelledby="h-sess">
  <div class="section-head"><h2 id="h-sess">Sessions</h2></div>
  <p>Signed in somewhere you no longer trust? This ends every session, including this one.</p>
  <form method="post" asp-page-handler="Revoke"><button class="secondary" type="submit">Sign out everywhere</button></form>
</section>
