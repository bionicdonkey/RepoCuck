@page "/requests"
@inject IDbContextFactory<AppDbContext> Dbf
@inject RequestService Svc
@functions {
    public List<Api.CoreApi.RequestRow> Rows { get; set; } = [];
    public async Task OnGetAsync(CancellationToken ct)
    {
        var uid = User.RequireId();
        await using var db = await Dbf.CreateDbContextAsync(ct);
        Rows = await Api.CoreApi.RequestQuery(db, r => r.RequestedBy == uid).OrderByDescending(r => r.CreatedAt).Take(200).ToListAsync(ct);
    }
    public async Task<IActionResult> OnPostCancelAsync(Guid id, CancellationToken ct)
    {
        try { await Svc.CancelAsync(id, User.RequireId(), User.IsAdmin(), ct); TempData["Flash"] = "Request cancelled."; }
        catch (ServiceException e) { TempData["Error"] = e.Message; }
        return RedirectToPage();
    }
}
@{ ViewData["Title"] = "My requests"; }
<div class="row"><h1 style="flex:1">My requests</h1><a class="btn" href="/requests/new">New request</a></div>
@if (Rows.Count == 0) { <p class="muted">You have not requested anything yet.</p> } else {
<table><thead><tr><th>When</th><th>Repository</th><th>Kind</th><th>Architectures</th><th>Status</th><th>Decision</th><th></th></tr></thead><tbody>
@foreach (var r in Rows) {
  <tr><td>@r.CreatedAt.ToString("u")</td><td><a href="/repos/@r.RepositoryId">@r.RepositoryName</a></td><td>@r.Kind</td><td>@string.Join(", ", r.Architectures)</td>
      <td><span class="badge @r.Status">@r.Status</span></td><td>@r.DecisionNote</td>
      <td>@if (r.Status == "pending") { <form method="post" asp-page-handler="Cancel" asp-route-id="@r.Id"><button class="secondary" type="submit">Cancel</button></form> }</td></tr>
}</tbody></table>}
