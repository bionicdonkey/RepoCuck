@using Microsoft.AspNetCore.Html
@{
    var nonce = Context.Nonce();
    var signedIn = User.Identity?.IsAuthenticated == true;
}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light dark">
  <title>@(ViewData["Title"] ?? "RepoCuck") - RepoCuck</title>
  <link rel="preload" href="/fonts/bricolage-grotesque.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/fonts/atkinson-next.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/css/site.css">
</head>
<body>
<partial name="_Icons" />
<a class="skip" href="#main">Skip to content</a>
@if (signedIn)
{
  <div class="shell">
    <header class="topbar">
      <a class="brand" href="/repos"><partial name="_Mark" />RepoCuck</a>
      <details>
        <summary>@Ui.Icon("menu") Menu</summary>
        <div class="menu-panel"><partial name="_Nav" /></div>
      </details>
    </header>
    <aside class="rail" aria-label="Sidebar">
      <a class="brand" href="/repos"><partial name="_Mark" />RepoCuck</a>
      <partial name="_Nav" />
    </aside>
    <div>
      <main id="main" class="page">
        @if (TempData["Flash"] is string flash) { <div class="flash" role="status">@flash</div> }
        @if (TempData["Error"] is string err) { <div class="notice error" role="alert">@Ui.Icon("alert")<p>@err</p></div> }
        @RenderBody()
      </main>
    </div>
  </div>
}
else
{
  <div class="public">
    <div class="top"><a class="brand" href="/"><partial name="_Mark" />RepoCuck</a><a class="btn secondary right" href="/login">Sign in</a></div>
    <main id="main">@RenderBody()</main>
  </div>
}
<script src="/js/site.js" nonce="@nonce"></script>
</body>
</html>
